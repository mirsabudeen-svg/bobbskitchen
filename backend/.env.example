# ── Anthropic / Claude ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=             # Required: Claude API key (story + design agents)

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://bobb:bobb@localhost:5432/bobb
# When running with docker-compose, use the service name:
# DATABASE_URL=postgresql+asyncpg://bobb:bobb@postgres:5432/bobb

# ── Image generation ──────────────────────────────────────────────────────────
FAL_API_KEY=                   # Required for fal.ai image generation
IMAGE_GEN_PROVIDER=fal         # fal | comfyui
COMFYUI_URL=http://localhost:8188   # Only needed when IMAGE_GEN_PROVIDER=comfyui

# ── WhatsApp / Twilio (Sprint 9) ──────────────────────────────────────────────
# Leave all blank to disable WhatsApp delivery (orders still work normally).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # Your Twilio WhatsApp sender number
TWILIO_TEMPLATE_SID_EN=        # Approved Meta template SID (English)
TWILIO_TEMPLATE_SID_ML=        # Approved Meta template SID (Malayalam)
# Must be a public HTTPS URL reachable by Meta (e.g. https://your-domain.com)
PUBLIC_MEDIA_BASE_URL=

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
PORT=8420
CACHE_DIR=cache/designs        # Relative to working directory; mounted in Docker
